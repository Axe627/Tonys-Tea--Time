@article{disilvestro2001crossvalidationbiphasic,
  title     = {A Cross-Validation of the Biphasic Poroviscoelastic Model of Articular Cartilage in Unconfined Compression, Indentation, and Confined Compression},
  author    = {DiSilvestro, Mark R. and Suh, Jun-Kyo Francis},
  year      = {2001},
  month     = apr,
  journal   = {Journal of Biomechanics},
  volume    = {34},
  number    = {4},
  pages     = {519--525},
  issn      = {00219290},
  doi       = {10.1016/S0021-9290(00)00224-4},
  urldate   = {2025-04-23},
  abstract  = {The biphasic poroviscoelastic (BPVE) model was curve fit to the simultaneous relaxation of reaction force and lateral displacement exhibited by articular cartilage in unconfined compression (n {$\frac{1}{4}$} 18). Model predictions were also made for the relaxation observed in reaction force during indentation with a porous plane-ended metal indenter (n {$\frac{1}{4}$} 4), indentation with a nonporous plane ended metal indenter (n {$\frac{1}{4}$} 4), and during confined compression (n {$\frac{1}{4}$} 4). Each prediction was made using material parameters resulting from curve fits of the unconfined compression response of the same tissue. The BPVE model was able to account for both the reaction force and the lateral displacement during unconfined compression very well. Furthermore, model predictions for both indentation and confined compression also followed the experimental data well. These results provide substantial evidence for the efficacy of the biphasic poroviscoelastic model for articular cartilage, as no successful cross-validation of a model simulation has been demonstrated using other mathematical models. \# 2001 Elsevier Science Ltd. All rights reserved.},
  copyright = {https://www.elsevier.com/tdm/userlicense/1.0/},
  langid    = {english}
}

@article{du2023meniscusheterogeneity,
  title     = {Meniscus Heterogeneity and {{3D-printed}} Strategies for Engineering Anisotropic Meniscus},
  author    = {Du, Ming-Ze and Dou, Yun and Ai, Li-Ya and Su, Tong and Zhang, Zhen and Chen, You-Rong and Jiang, Dong},
  year      = {2023},
  month     = feb,
  journal   = {International Journal of Bioprinting},
  volume    = {9},
  number    = {3},
  pages     = {693},
  issn      = {2424-7723, 2424-8002},
  doi       = {10.18063/ijb.693},
  urldate   = {2025-04-25},
  abstract  = {The meniscus is a fibrocartilaginous tissue of the knee joint that plays an important role in load transmission, shock absorption, joint stability maintenance, and contact stress reduction. Mild meniscal injuries can be treated with simple sutures, whereas severe injuries inevitably require meniscectomy. Meniscectomy destroys the mechanical microenvironment of the knee joint, leading to cartilage degeneration and osteoarthritis. Tissue engineering techniques, as a strategy with diverse sources and customizable and adjustable mechanical and biological properties, have emerged as promising approaches for the treatment of meniscal injuries and are represented by 3D printing. Notably, the heterogeneity of the meniscus, including its anatomical structure, cell phenotype, extracellular matrix, and biomechanical properties, is crucial for its normal function. Therefore, the construction of heterogeneous tissue-engineered menisci (TEM) has become a research hotspot in this field. In this review, we systematically summarize the heterogeneity of menisci and 3D-printed strategies for tissue-engineered anisotropic menisci. The manufacturing techniques, biomaterial combinations, surface functionalization, growth factors, and bioreactors related to 3D-printed strategies are introduced and a promising direction for the future research is proposed.},
  copyright = {https://creativecommons.org/licenses/by-nc/4.0},
  langid    = {english}
}

@article{eganarchitecturalacoustics,
  title  = {Architectural {{Acoustics}}},
