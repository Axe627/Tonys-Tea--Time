@article{zhang20193dprinting,
  title     = {{{3D Printing Super Strong Hydrogel}} for {{Artificial Meniscus}}},
  author    = {Zhang, Zimeng and Liu, Ruochen and Zepeda, Herman and Zeng, Li and Qiu, Jingjing and Wang, Shiren},
